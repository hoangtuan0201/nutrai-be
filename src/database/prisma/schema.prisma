// ═══════════════════════════════════════════════════════════════
// NutraAI — Streamlined & Complete Prisma Schema
// Optimized: 16 Core Tables across 8 Domains
// Fully aligned with Project Proposals & Mobile Requirements
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN 1: AUTHENTICATION & ACCOUNT
// ═══════════════════════════════════════════════════════════════

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id                       String       @id @default(uuid())
  email                    String       @unique
  passwordHash             String?      // null cho tài khoản OAuth Google
  name                     String?
  avatarUrl                String?
  role                     Role         @default(USER)
  authProvider             AuthProvider @default(EMAIL)
  firebaseUid              String?      @unique
  isActive                 Boolean      @default(true)
  emailVerified            Boolean      @default(false)

  // Token đặt lại mật khẩu trực tiếp trong User
  passwordResetToken       String?      @unique
  passwordResetExpires     DateTime?

  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  deletedAt                DateTime?

  // Relations
  refreshTokens            RefreshToken[]
  deviceTokens             DeviceToken[]
  profile                  UserProfile?
  nutritionTargets         NutritionTarget[]
  meals                    Meal[]
  aiMealAnalyses           AiMealAnalysis[]
  chatConversations        ChatConversation[]
  weightLogs               WeightLog[]
  subscriptions            UserSubscription[]
  payments                 Payment[]
  notifications            Notification[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceInfo String?
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN 2: USER PROFILE & FITNESS GOAL
// ═══════════════════════════════════════════════════════════════

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum FitnessGoal {
  WEIGHT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
}

model UserProfile {
  id                           String        @id @default(uuid())
  userId                       String        @unique
  user                         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth                  DateTime?     @db.Date
  gender                       Gender?
  heightCm                     Float?
  weightKg                     Float?
  targetWeightKg               Float?        // Cân nặng mục tiêu (đồng bộ với Onboarding & Settings)
  activityLevel                ActivityLevel?
  fitnessGoal                  FitnessGoal?

  // Cài đặt nhắc nhở bữa ăn tích hợp trong Profile
  notificationMealReminder     Boolean       @default(true)
  timezone                     String        @default("Asia/Ho_Chi_Minh")
  reminderBreakfastMinutes     Int?          @default(480)  // 08:00
  reminderLunchMinutes         Int?          @default(720)  // 12:00
  reminderDinnerMinutes        Int?          @default(1080) // 18:00

  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  @@map("user_profiles")
}

model NutritionTarget {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories Float
  dailyProtein  Float
  dailyCarbs    Float
  dailyFat      Float
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([userId, isActive])
  @@map("nutrition_targets")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN 3: FOOD & MEAL TRACKING
// ═══════════════════════════════════════════════════════════════

model Food {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  caloriesPer100g    Float
  proteinPer100g     Float
  carbsPer100g       Float
  fatPer100g         Float
  servingUnit        String   @default("g")
  defaultServingSize Float    @default(100)
  imageUrl           String?
  isVerified         Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mealItems          MealItem[]

  @@index([name])
  @@map("foods")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  AI_TEXT
  AI_IMAGE
}

model Meal {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType      MealType
  name          String?
  totalCalories Float
  totalProtein  Float
  totalCarbs    Float
  totalFat      Float
  imageUrl      String?
  source        MealSource      @default(MANUAL)
  loggedDate    DateTime        @db.Date
  loggedAt      DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Quan hệ: 1 Bữa ăn gồm nhiều Món (MealItem) và liên kết ngược tới phân tích AI (nếu tạo từ AI)
  items          MealItem[]
  aiMealAnalysis AiMealAnalysis?

  @@index([userId, loggedDate])
  @@index([userId, mealType])
  @@map("meals")
}

model MealItem {
  id                 String   @id @default(uuid())
  mealId             String
  meal               Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId             String?
  food               Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  foodName           String
  portionDescription String?
  quantity           Float    @default(1)
  unit               String   @default("serving")
  calories           Float
  protein            Float
  carbs              Float
  fat                Float
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([mealId])
  @@map("meal_items")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN 4: AI FEATURES
// ═══════════════════════════════════════════════════════════════

enum AiInputType {
  TEXT
  IMAGE
}

enum AiAnalysisStatus {
  PENDING    // Vừa phân tích xong, chờ người dùng xem xét
  CONFIRMED  // Người dùng xác nhận lưu vào Meals
  EDITED     // Người dùng chỉnh sửa rồi mới lưu
  FAILED     // AI lỗi hoặc không nhận diện được món ăn
  CANCELLED  // Người dùng hủy, không lưu vào Meals
}

model AiMealAnalysis {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Liên kết tới Meal là TÙY CHỌN (1-0..1): 
  // Chỉ có khi người dùng bấm xác nhận tạo bữa ăn, null nếu người dùng hủy/chưa lưu
  mealId        String?          @unique
  meal          Meal?            @relation(fields: [mealId], references: [id], onDelete: SetNull)
  inputType     AiInputType
  inputText     String?
  inputImageUrl String?
  rawAiResponse Json
  parsedItems   Json
  totalCalories Float
  totalProtein  Float
  totalCarbs    Float
  totalFat      Float
  confidence    Float
  status        AiAnalysisStatus @default(PENDING)
  aiModel       String
  tokensUsed    Int?
  latencyMs     Int?
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@map("ai_meal_analyses")
}

model ChatConversation {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?
  isActive      Boolean       @default(true)
  lastMessageAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages      ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id              String           @id @default(uuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            ChatRole
  content         String
  contextSnapshot Json?
  tokensUsed      Int?
  latencyMs       Int?
  createdAt       DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN 5: PROGRESS & WEIGHT
// ═══════════════════════════════════════════════════════════════

model WeightLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  note       String?
  loggedDate DateTime @db.Date
  createdAt  DateTime @default(now())

  @@index([userId, loggedDate])
  @@map("weight_logs")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN 6: SUBSCRIPTIONS & PAYMENTS
// ═══════════════════════════════════════════════════════════════

enum BillingPeriod {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String             @unique
  description   String?
  price         Float
  currency      String             @default("VND")
  billingPeriod BillingPeriod
  features      Json
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  subscriptions UserSubscription[]
  payments      Payment[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model UserSubscription {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  status          SubscriptionStatus
  googlePlayToken String?
  transactionId   String?            @unique
  startsAt        DateTime
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments        Payment[]

  @@index([userId, status])
  @@map("user_subscriptions")
}

enum PaymentMethod {
  GOOGLE_PLAY
  APPLE_PAY
  STRIPE
  VNPAY
  MOMO
  BANK_TRANSFER
  SEPAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  EXPIRED
}

model Payment {
  id             String            @id @default(uuid())
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String?
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Float
  currency       String            @default("VND")
  paymentMethod  PaymentMethod
  status         PaymentStatus
  transactionId  String            @unique
  paymentCode    String?           @unique
  providerTxId   String?           @unique
  receiptData    String?
  expiresAt      DateTime?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  events         PaymentEvent[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([paymentCode])
  @@map("payments")
}

model PaymentEvent {
  id           String   @id @default(uuid())
  paymentId    String?
  payment      Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider     String
  eventId      String   @unique
  eventType    String
  payload      Json
  status       String   @default("PROCESSED")
  errorMessage String?
  processedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([paymentId])
  @@index([provider, eventId])
  @@map("payment_events")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN 7: NOTIFICATIONS & DEVICE PUSH (FCM)
// ═══════════════════════════════════════════════════════════════

enum NotificationType {
  MEAL_REMINDER
  GOAL_ALERT
  AI_RECOMMENDATION
  SUBSCRIPTION
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

enum Platform {
  ANDROID
  IOS
}

model DeviceToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  platform    Platform
  deviceModel String?
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("device_tokens")
}
